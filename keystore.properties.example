# Copy to keystore.properties (git-ignored) to sign release builds locally.
# Create the keystore first:
#
#   keytool -genkeypair -v \
#     -keystore lumen-release.jks \
#     -alias lumen \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Keep this file and the .jks out of version control. Losing the keystore means you
# can never ship an update to an app already installed under this signature.

storeFile=../lumen-release.jks
storePassword=CHANGE_ME
keyAlias=lumen
keyPassword=CHANGE_ME
